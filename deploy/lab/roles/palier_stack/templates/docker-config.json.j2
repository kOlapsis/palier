{
  "auths": {
{% for r in palier_registries | selectattr('address') | selectattr('user') | selectattr('password') | rejectattr('address', 'equalto', 'https://index.docker.io/v1/') %}
    {{ r.address | to_json }}: {"auth": {{ (r.user ~ ':' ~ r.password) | b64encode | to_json }}}{{ "," if not loop.last }}
{% endfor %}
  },
  "credHelpers": {
    "https://index.docker.io/v1/": "env",
    "{{ topology.vm.address }}:{{ topology.ports.labreg }}": "env"
  }
}
