# Started by the Palier bench; version pinned in deploy/lab/versions.yml.
name: mariadb

services:
  mariadb:
    image: {{ mariadb.image }}:{{ mariadb.tag }}
    restart: always
    labels:
      palier.backup: dump
      palier.backup.to: dav:palier
    environment:
      MARIADB_ROOT_PASSWORD: palier-lab-password
      MARIADB_DATABASE: shop
      MARIADB_USER: app
      MARIADB_PASSWORD: palier-lab-password
    volumes:
      - data:/var/lib/mysql
      - ./seed.sql:/docker-entrypoint-initdb.d/seed.sql:ro

volumes:
  data: {}
