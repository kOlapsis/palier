# Started by the Palier bench; version pinned in deploy/lab/versions.yml.
name: nginx

services:
  nginx:
    image: {{ nginx.image }}:{{ nginx.tag }}
    restart: always
    labels:
      palier.hook.backup: tar czf /backup/nginx-conf.tgz /etc/nginx
    ports:
      - "{{ topology.ports.nginx }}:80"
